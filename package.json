{
  "name": "qingshuige-search",
  "version": "0.2.0",
  "description": "Framework-agnostic local full-text search engine for static sites, with CJK bigram tokenization and inverted indexes.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./browser": "./adapters/browser/index.js",
    "./vue": "./frontend/components/SearchPanel.vue"
  },
  "files": [
    "src",
    "adapters",
    "frontend",
    "assets/qingshuige-search",
    "docs/API.zh-CN.md",
    "docs/ARCHITECTURE.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:core": "node --test test/search-engine.test.js test/tokenizer.test.js test/core-api.test.js",
    "test:hugo": "node --test test/hugo-adapter.test.js",
    "benchmark": "node --expose-gc benchmark/run.mjs"
  },
  "keywords": [
    "search",
    "full-text-search",
    "static-site",
    "hugo",
    "cjk",
    "inverted-index"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanmuweyyyyyy/qingshuige-search.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "jsdom": "26.1.0",
    "vite": "8.2.2",
    "vue": "3.5.41"
  }
}
